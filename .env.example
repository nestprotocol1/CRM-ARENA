# Plantilla de variables de entorno. Copiar a .env.local y completar.
# .env.local NUNCA se commitea (está en .gitignore).

# Base: vacío = PGlite local en .data/pglite. Con URL = Supabase (pooler, puerto 6543).
DATABASE_URL=

# Realtime (la bandeja se actualiza sola, sin polling)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Proveedor
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api   # base real; vacío = el default del código
ZERNIO_WEBHOOK_SECRET=
ZERNIO_MOCK=1            # 1 = adaptador mock local (sin red). En producción: VACÍO
ZERNIO_PROFILE_ID=       # opcional: perfil para /v1/connect/{platform} (si no, el primero)

# Agente
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Barridos (Bearer o X-Backfill-Token)
BACKFILL_TOKEN=

# Gate de la app. Vacío = app abierta (modo desarrollo).
CRM_PASSWORD=
